    "  place    what=tile name      put that many down",
    "  defeat   creatures driven off",
    "  dawn     nights survived",
    "  depth    tiles below the surface reached",
    "  layer    depth band reached: 1 underground, 2 caverns, 3 deep",
    "  chest    chests opened",
    "  heart    life crystals taken",
    "  tame     creatures befriended"
